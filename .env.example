# 复制为 .env 后由 docker compose 读取（.env 已 gitignore）
# cp .env.example .env

# Master WebUI 鉴权（生产建议设置）
WEB_TOKEN=

# Worker
TICKET_INTERVAL=300

# 通知（可选，可多选；抢票成功时并发推送）
# PUSHPLUS_TOKEN=
# BARK_TOKEN=          # key 或 https://api.day.app/xxx
# SERVERCHAN_KEY=      # Server酱 Turbo SendKey
# SERVERCHAN3_API_URL= # Server酱3 完整推送 URL
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_HTTP_PROXY= # 可选，如 http://127.0.0.1:7890

# TICKET_TIME_START=2026-07-24T13:14
# RATE_LIMIT_DELAY_MS=300
# RISK_LOCAL_RETRIES=5
# RISK_COOLDOWN_BASE_MS=1000
# RISK_COOLDOWN_MAX_SEC=30

# 代理池（可选；空则直连）
# PROXY_LIST=http://user:pass@1.2.3.4:8080,socks5://5.6.7.8:1080
# PROXY_MAX_FAILS=3
# PROXY_COOLDOWN_SEC=30
# PROXY_MAX_BACKOFF_SEC=300
# PROXY_API_URL=
# PROXY_API_COUNT=5
# PROXY_API_SCHEME=http

# 连接预热 / 多连接 create（2～3 节点建议）
# CONN_PER_HOST=4
# CREATE_BATCH_SIZE=2
# ENABLE_WARMUP=true
